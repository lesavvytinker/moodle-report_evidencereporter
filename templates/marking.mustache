{{!
    @template report_evidencereporter/marking

    The assessor's marking grid for a course: learners by assessment, most urgent first.

    Example context (json):
    {
        "action": "https://example.com/report/evidencereporter/marking.php", "courseid": 2, "learnerlabel": "Learner",
        "units": [{"id": 0, "label": "All units", "selected": true}, {"id": 5, "label": "CUAIND512 Enhance practice", "selected": false}],
        "oneunit": false, "hasassessments": true, "hasrows": true,
        "assessments": [{"name": "AT1 Quiz", "url": "https://example.com/mod/quiz/view.php?id=1", "icon": "https://example.com/icon.svg",
            "decl": {"url": "https://example.com/report/evidencereporter/declarations.php?cmid=1", "outstanding": 2, "hasoutstanding": true, "held": true} }],
        "hasdecl": true,
        "rows": [{"name": "Paige Palette", "profileurl": "https://example.com/user/view.php?id=3", "highlight": "amber",
            "cells": [{"status": "tomark", "age": "amber", "label": "To mark: 8 days", "grade": "", "attempt": "Attempt 1 of 3",
                "url": "https://example.com/mod/quiz/report.php?id=1&mode=grading", "flag": false, "noattemptsleft": false,
                "adjustmentsurl": "https://example.com/report/evidencereporter/adjustments.php?cmid=1", "hasadjustments": true,
                "adjustments": 1, "hastoconfirm": false, "toconfirm": 0}],
            "unit": null, "hasready": false, "readycount": 0,
            "summaryurl": "https://example.com/report/evidencereporter/print.php?userid=3",
            "hasdecl": true, "declurl": "https://example.com/report/evidencereporter/declarations.php?courseid=2&userid=3",
            "declmissing": 1, "hasdeclmissing": true, "readypendingcount": 0, "hasreadypending": false,
            "plans": [{"name": "Diploma of Graphic Design", "url": "https://example.com/admin/tool/lp/plan.php?id=4"}],
            "hasplans": true}],
        "counts": {"tomark": 1, "overdue": 1, "amber": 1, "red": 0, "feedback": 0, "notreleased": 0, "toconfirm": 0, "ready": 0, "torecord": 1, "hastorecord": true, "nothing": false},
        "thresholds": {"amber": 7, "red": 14},
        "overviewurl": "https://example.com/report/evidencereporter/marking.php"
    }
}}
<div class="report-evidencereporter-marking">
    <form method="get" action="{{action}}" class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <input type="hidden" name="courseid" value="{{courseid}}">
        <label for="report_evidencereporter-markingunit" class="me-1">{{#str}} markingunit, report_evidencereporter {{/str}}</label>
        <select id="report_evidencereporter-markingunit" name="unitid" class="form-select w-auto" data-er-autosubmit>
            {{#units}}<option value="{{id}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/units}}
        </select>
        <noscript><button type="submit" class="btn btn-secondary">{{#str}} show {{/str}}</button></noscript>
        <a class="ms-auto small" href="{{overviewurl}}">{{#str}} markingallcourses, report_evidencereporter {{/str}}</a>
    </form>

    <ul class="er-markingcounts list-inline mb-2">
        {{#counts}}
        <li class="list-inline-item"><span class="er-count">{{tomark}}</span> {{#str}} markingcount_tomark, report_evidencereporter {{/str}}</li>
        <li class="list-inline-item er-age-amber-text"><span class="er-count">{{amber}}</span> {{#str}} markingcount_amber, report_evidencereporter, {{thresholds.amber}} {{/str}}</li>
        <li class="list-inline-item er-age-red-text"><span class="er-count">{{red}}</span> {{#str}} markingcount_red, report_evidencereporter, {{thresholds.red}} {{/str}}</li>
        <li class="list-inline-item"><span class="er-count">{{feedback}}</span> {{#str}} markingcount_feedback, report_evidencereporter {{/str}}</li>
        <li class="list-inline-item"><span class="er-count">{{notreleased}}</span> {{#str}} markingcount_notreleased, report_evidencereporter {{/str}}</li>
        <li class="list-inline-item"><span class="er-count">{{toconfirm}}</span> {{#str}} markingcount_toconfirm, report_evidencereporter {{/str}}</li>
        <li class="list-inline-item"><span class="er-count">{{ready}}</span> {{#str}} markingcount_ready, report_evidencereporter {{/str}}</li>
        {{#hastorecord}}<li class="list-inline-item er-declheld-text"><span class="er-count">{{torecord}}</span> {{#str}} markingcount_torecord, report_evidencereporter {{/str}}</li>{{/hastorecord}}
        {{/counts}}
    </ul>
    <p class="small text-muted">{{#str}} markinglegend, report_evidencereporter, { "amber": {{thresholds.amber}}, "red": {{thresholds.red}} } {{/str}}</p>

    {{^hasassessments}}
    <div class="alert alert-info">{{#str}} markingnoassessments, report_evidencereporter {{/str}}</div>
    {{/hasassessments}}
    {{#hasassessments}}
    {{^hasrows}}
    <div class="alert alert-info">{{#str}} markingnolearners, report_evidencereporter {{/str}}</div>
    {{/hasrows}}
    {{#hasrows}}
    <div class="table-responsive">
    <table class="table table-sm table-bordered er-marking">
        <thead>
            <tr>
                <th scope="col">{{learnerlabel}}</th>
                {{#assessments}}
                <th scope="col"><a href="{{url}}"><img src="{{icon}}" class="icon" alt="">{{name}}</a>
                    {{#decl}}
                    <div class="small fw-normal">
                        <a href="{{url}}" class="er-decllink">{{#hasoutstanding}}{{#str}} markingdecl, report_evidencereporter, {{outstanding}} {{/str}}{{/hasoutstanding}}{{^hasoutstanding}}{{#str}} markingdecldone, report_evidencereporter {{/str}}{{/hasoutstanding}}</a>
                        {{#held}}<span class="badge er-declheld">{{#str}} markingdeclheld, report_evidencereporter {{/str}}</span>{{/held}}
                    </div>
                    {{/decl}}
                </th>
                {{/assessments}}
                {{#hasdecl}}<th scope="col">{{#str}} markingdeclcol, report_evidencereporter {{/str}}</th>{{/hasdecl}}
                <th scope="col">{{#str}} markingplan, report_evidencereporter {{/str}}</th>
                <th scope="col">{{#oneunit}}{{#str}} markingunitresult, report_evidencereporter {{/str}}{{/oneunit}}{{^oneunit}}{{#str}} markingsignoff, report_evidencereporter {{/str}}{{/oneunit}}</th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
            <tr class="{{#highlight}}er-row-{{.}}{{/highlight}}">
                <th scope="row">
                    <a href="{{profileurl}}">{{name}}</a>
                    <div class="small">
                        <a href="{{summaryurl}}">{{#str}} markingsummary, report_evidencereporter {{/str}}</a>
                    </div>
                </th>
                {{#cells}}
                <td class="er-cell er-status-{{status}}{{#age}} er-age-{{.}}{{/age}}">
                    <a href="{{url}}" class="er-celllink">{{#flag}}<span class="er-flag" aria-hidden="true">&#9873;</span> {{/flag}}{{label}}</a>
                    {{#grade}}<div class="small">{{.}}</div>{{/grade}}
                    {{#attempt}}<div class="small text-muted">{{.}}</div>{{/attempt}}
                    {{#noattemptsleft}}<div><span class="badge er-noattempts">{{#str}} snapnoattemptsleft, report_evidencereporter {{/str}}</span></div>{{/noattemptsleft}}
                    {{#adjustmentsurl}}
                    <div class="small">
                        <a href="{{.}}" class="er-ra">{{#hasadjustments}}{{#str}} markingra, report_evidencereporter, {{adjustments}} {{/str}}{{/hasadjustments}}{{^hasadjustments}}{{#str}} markingrana, report_evidencereporter {{/str}}{{/hasadjustments}}</a>
                        {{#hastoconfirm}}<span class="er-ratoconfirm">· {{#str}} markingratoconfirm, report_evidencereporter, {{toconfirm}} {{/str}}</span>{{/hastoconfirm}}
                    </div>
                    {{/adjustmentsurl}}
                </td>
                {{/cells}}
                {{#hasdecl}}
                <td class="er-declcell">
                    <a href="{{declurl}}">{{#hasdeclmissing}}<span class="badge er-declheld">{{#str}} markingdecl, report_evidencereporter, {{declmissing}} {{/str}}</span>{{/hasdeclmissing}}{{^hasdeclmissing}}{{#str}} markingdecldone, report_evidencereporter {{/str}}{{/hasdeclmissing}}</a>
                </td>
                {{/hasdecl}}
                <td class="er-plancell">
                    {{#plans}}<div><a href="{{url}}">{{name}}</a></div>{{/plans}}
                    {{^hasplans}}<span class="text-muted">{{#str}} markingnoplan, report_evidencereporter {{/str}}</span>{{/hasplans}}
                </td>
                <td>
                    {{#unit}}
                    {{#rated}}<span>{{.}}</span>{{/rated}}
                    {{#ready}}<a href="{{url}}" class="badge er-ready">{{#str}} markingready, report_evidencereporter {{/str}}</a>{{/ready}}
                    {{#readypending}}<a href="{{declurl}}" class="badge er-readypending">{{#str}} markingreadypending, report_evidencereporter {{/str}}</a>{{/readypending}}
                    {{^rated}}{{^ready}}{{^readypending}}<a href="{{url}}" class="small text-muted">{{#str}} markingnotrated, report_evidencereporter {{/str}}</a>{{/readypending}}{{/ready}}{{/rated}}
                    {{/unit}}
                    {{^unit}}
                    {{#hasready}}<span class="badge er-ready">{{#str}} markingreadycount, report_evidencereporter, {{readycount}} {{/str}}</span>{{/hasready}}
                    {{#hasreadypending}}<a href="{{declurl}}" class="badge er-readypending">{{#str}} markingreadypendingcount, report_evidencereporter, {{readypendingcount}} {{/str}}</a>{{/hasreadypending}}
                    {{/unit}}
                </td>
            </tr>
            {{/rows}}
        </tbody>
    </table>
    </div>
    {{/hasrows}}
    {{/hasassessments}}
</div>
{{#js}}
document.querySelectorAll('.report-evidencereporter-marking [data-er-autosubmit]').forEach(function(select) {
    select.addEventListener('change', function() {
        select.form.submit();
    });
});
{{/js}}
