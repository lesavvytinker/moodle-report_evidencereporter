{{!
    @template report_evidencereporter/beforemarking

    Before marking a learner's assessment: the assessment tool, the learner's RA and LLN, then start marking.

    Example context (json):
    {
        "activity": "AT1 Report", "activityurl": "https://example.com/mod/assign/view.php?id=1", "learnername": "Sam Student",
        "tool": {"complete": false, "missing": "Tool version, Reviewed by", "canedit": false,
            "editurl": "https://example.com/course/modedit.php?update=1", "notified": "",
            "notifyurl": "https://example.com/report/evidencereporter/beforemarking.php?cmid=1&userid=3&action=notify"},
        "declapplies": true, "declcomplete": false, "decl": null, "ready": false,
        "missing": "Assessment tool details, RA and LLN",
        "starturl": "https://example.com/report/evidencereporter/beforemarking.php?cmid=1&userid=3&action=start",
        "markingurl": "https://example.com/report/evidencereporter/marking.php?courseid=2"
    }
}}
<div class="report-evidencereporter-beforemarking report-evidencereporter-declarations">
    <p>{{#str}} beforeintro, report_evidencereporter, { "activity": {{#quote}}{{activity}}{{/quote}}, "learner": {{#quote}}{{learnername}}{{/quote}} } {{/str}}</p>

    <section class="card mb-3 er-beforestep {{#tool.complete}}er-stepdone{{/tool.complete}}">
        <div class="card-body">
            <h3 class="h5">{{#tool.complete}}<span class="er-stepmark" aria-hidden="true">&#10003;</span>{{/tool.complete}}{{^tool.complete}}<span class="er-stepnum">1</span>{{/tool.complete}} {{#str}} beforesteptool, report_evidencereporter {{/str}}</h3>
            {{#tool.complete}}<p class="mb-0">{{#str}} beforetooldone, report_evidencereporter {{/str}}</p>{{/tool.complete}}
            {{^tool.complete}}
            <p>{{#str}} beforetoolmissing, report_evidencereporter, {{tool.missing}} {{/str}}</p>
            {{#tool.canedit}}<a class="btn btn-primary" href="{{tool.editurl}}" target="_blank" rel="noopener">{{#str}} beforetooledit, report_evidencereporter {{/str}}</a>{{/tool.canedit}}
            {{^tool.canedit}}
            {{#tool.notified}}<p class="text-muted mb-2">{{.}}</p>{{/tool.notified}}
            <a class="btn {{#tool.notified}}btn-outline-secondary{{/tool.notified}}{{^tool.notified}}btn-primary{{/tool.notified}}" href="{{tool.notifyurl}}">{{#str}} beforetoolnotify, report_evidencereporter {{/str}}</a>
            {{/tool.canedit}}
            {{/tool.complete}}
        </div>
    </section>

    {{#declapplies}}
    <section class="card mb-3 er-beforestep {{#declcomplete}}er-stepdone{{/declcomplete}}">
        <div class="card-body">
            <h3 class="h5">{{#declcomplete}}<span class="er-stepmark" aria-hidden="true">&#10003;</span>{{/declcomplete}}{{^declcomplete}}<span class="er-stepnum">2</span>{{/declcomplete}} {{#str}} beforestepdecl, report_evidencereporter {{/str}}</h3>
            {{^declcomplete}}<p>{{#str}} beforedeclintro, report_evidencereporter {{/str}}</p>{{/declcomplete}}
            {{#decl}}{{> report_evidencereporter/declarations_table }}{{/decl}}
        </div>
    </section>
    {{/declapplies}}

    <section class="card mb-3 er-beforestep">
        <div class="card-body">
            <h3 class="h5"><span class="er-stepnum">{{#declapplies}}3{{/declapplies}}{{^declapplies}}2{{/declapplies}}</span> {{#str}} beforestepmark, report_evidencereporter {{/str}}</h3>
            {{#ready}}
            <p>{{#str}} beforeready, report_evidencereporter {{/str}}</p>
            <a class="btn btn-primary" href="{{starturl}}" target="_blank" rel="noopener">{{#str}} beforestart, report_evidencereporter {{/str}}</a>
            {{/ready}}
            {{^ready}}
            <div class="alert alert-warning">{{#str}} beforenotready, report_evidencereporter, {{missing}} {{/str}}</div>
            <a class="btn btn-outline-secondary" href="{{starturl}}" target="_blank" rel="noopener">{{#str}} beforestartanyway, report_evidencereporter {{/str}}</a>
            {{/ready}}
            <a class="btn btn-link" href="{{markingurl}}">{{#str}} declbacktomarking, report_evidencereporter {{/str}}</a>
        </div>
    </section>
</div>
