{{!
    @template report_evidencereporter/marking_overview

    One line per course the assessor marks in.

    Example context (json):
    {
        "hascourses": true,
        "courses": [{"name": "Professional practice", "url": "https://example.com/report/evidencereporter/marking.php?courseid=2",
            "tomark": 5, "overdue": 2, "amber": 1, "red": 1, "feedback": 1, "notreleased": 0, "toconfirm": 1, "ready": 0, "torecord": 2, "hastorecord": true, "nothing": false}],
        "total": {"tomark": 5, "overdue": 2, "amber": 1, "red": 1, "feedback": 1, "notreleased": 0, "toconfirm": 1, "ready": 0, "torecord": 2, "hastorecord": true, "nothing": false},
        "thresholds": {"amber": 7, "red": 14}
    }
}}
<div class="report-evidencereporter-marking">
    <p>{{#str}} markingoverviewintro, report_evidencereporter {{/str}}</p>
    {{^hascourses}}
    <div class="alert alert-info">{{#str}} markingnocourses, report_evidencereporter {{/str}}</div>
    {{/hascourses}}
    {{#hascourses}}
    <table class="table table-sm er-markingoverview">
        <thead>
            <tr>
                <th scope="col">{{#str}} course {{/str}}</th>
                <th scope="col" class="text-end">{{#str}} markingcount_tomark, report_evidencereporter {{/str}}</th>
                <th scope="col" class="text-end">{{#str}} markingcount_amber, report_evidencereporter, {{thresholds.amber}} {{/str}}</th>
                <th scope="col" class="text-end">{{#str}} markingcount_red, report_evidencereporter, {{thresholds.red}} {{/str}}</th>
                <th scope="col" class="text-end">{{#str}} markingcount_feedback, report_evidencereporter {{/str}}</th>
                <th scope="col" class="text-end">{{#str}} markingcount_notreleased, report_evidencereporter {{/str}}</th>
                <th scope="col" class="text-end">{{#str}} markingcount_torecord, report_evidencereporter {{/str}}</th>
                <th scope="col" class="text-end">{{#str}} markingcount_toconfirm, report_evidencereporter {{/str}}</th>
                <th scope="col" class="text-end">{{#str}} markingcount_ready, report_evidencereporter {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#courses}}
            <tr class="{{#red}}er-row-red{{/red}}{{^red}}{{#amber}}er-row-amber{{/amber}}{{/red}}">
                <th scope="row"><a href="{{url}}">{{name}}</a>{{#nothing}} <span class="small text-muted">· {{#str}} markingcaughtup, report_evidencereporter {{/str}}</span>{{/nothing}}</th>
                <td class="text-end">{{tomark}}</td>
                <td class="text-end">{{amber}}</td>
                <td class="text-end">{{red}}</td>
                <td class="text-end">{{feedback}}</td>
                <td class="text-end">{{notreleased}}</td>
                <td class="text-end{{#hastorecord}} er-declheld-text fw-bold{{/hastorecord}}">{{torecord}}</td>
                <td class="text-end">{{toconfirm}}</td>
                <td class="text-end">{{ready}}</td>
            </tr>
            {{/courses}}
        </tbody>
    </table>
    {{/hascourses}}
</div>
