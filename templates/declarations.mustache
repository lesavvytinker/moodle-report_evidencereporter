{{!
    @template report_evidencereporter/declarations

    RA and LLN for one assessment (a row per learner) or one learner (a row per assessment): an explainer, then a tick
    box and details for each row, with tick-all boxes.

    Example context (json):
    {
        "action": "https://example.com/report/evidencereporter/declarations.php?cmid=1", "sesskey": "abc",
        "canmanage": true, "learnermode": false, "rowlabel": "Learner", "applies": true, "held": true, "exempt": false,
        "learnersheld": 0, "haslearnersheld": false, "outstanding": 1, "hasoutstanding": true, "hasrows": true,
        "shared": "AT1 Attempt 2", "backurl": null,
        "rows": [{"key": 3, "name": "Paige Palette", "canedit": true, "recorded": false, "partly": false, "recordedtext": "",
            "carried": "", "rayes": true, "rano": false, "radetails": "Extra time (20 minutes)", "raerror": "",
            "llnyes": false, "llnno": false, "llndetails": "", "llnerror": "",
            "adjustments": "Extra time (20 minutes)",
            "adjustmentsurl": "https://example.com/report/evidencereporter/adjustments.php?cmid=1", "held": false, "url": null}]
    }
}}
<div class="report-evidencereporter-declarations">
    <div class="alert alert-info er-declexplainer">
        <h3 class="h5">{{#str}} declexplainheading, report_evidencereporter {{/str}}</h3>
        <dl class="mb-2">
            <dt>{{#str}} declra, report_evidencereporter {{/str}}</dt>
            <dd>{{#str}} declraexplain, report_evidencereporter {{/str}}</dd>
            <dt>{{#str}} decllln, report_evidencereporter {{/str}}</dt>
            <dd>{{#str}} decllnexplain, report_evidencereporter {{/str}}</dd>
        </dl>
        <p class="fw-bold mb-1">{{#str}} decltodo, report_evidencereporter {{/str}}</p>
        <ol class="mb-0">
            <li>{{#str}} decltodo1, report_evidencereporter {{/str}}</li>
            <li>{{#str}} decltodo2, report_evidencereporter {{/str}}</li>
            <li>{{#str}} decltodo3, report_evidencereporter {{/str}}</li>
            <li>{{#str}} decltodo4, report_evidencereporter {{/str}}</li>
        </ol>
    </div>

    {{#learnermode}}
    <div class="alert {{#hasoutstanding}}alert-danger{{/hasoutstanding}}{{^hasoutstanding}}alert-success{{/hasoutstanding}} er-declhold" role="status">
        <p class="fw-bold mb-1">{{#str}} decllearnerwarning, report_evidencereporter {{/str}}</p>
        {{#hasoutstanding}}<p class="mb-0">{{#str}} decllearneroutstanding, report_evidencereporter, {{outstanding}} {{/str}}</p>{{/hasoutstanding}}
        {{^hasoutstanding}}<p class="mb-0">{{#str}} decllearnerdone, report_evidencereporter {{/str}}</p>{{/hasoutstanding}}
    </div>
    {{/learnermode}}
    {{^learnermode}}
    {{#applies}}
    <div class="alert {{#held}}alert-danger{{/held}}{{^held}}{{#hasoutstanding}}alert-warning{{/hasoutstanding}}{{^hasoutstanding}}alert-success{{/hasoutstanding}}{{/held}} er-declhold" role="status">
        <p class="fw-bold mb-1">{{#str}} declholdwarning, report_evidencereporter {{/str}}</p>
        {{#held}}<p class="mb-0">{{#str}} declheldnow, report_evidencereporter, {{outstanding}} {{/str}}</p>{{/held}}
        {{^held}}
        {{#exempt}}<p class="mb-0">{{#str}} declexempt, report_evidencereporter {{/str}}</p>{{/exempt}}
        {{^exempt}}{{^hasoutstanding}}<p class="mb-0">{{#str}} declallrecorded, report_evidencereporter {{/str}}</p>{{/hasoutstanding}}{{/exempt}}
        {{#hasoutstanding}}<p class="mb-0">{{#str}} decloutstanding, report_evidencereporter, {{outstanding}} {{/str}}</p>{{/hasoutstanding}}
        {{#haslearnersheld}}<p class="mb-0">{{#str}} decllearnersheld, report_evidencereporter, {{learnersheld}} {{/str}}</p>{{/haslearnersheld}}
        {{/held}}
    </div>
    {{/applies}}
    {{^applies}}
    <div class="alert alert-secondary er-declhold" role="status">{{#str}} declnotcounted, report_evidencereporter {{/str}}</div>
    {{/applies}}
    {{/learnermode}}

    {{#shared}}
    <p class="small er-declshared">{{#str}} declshared, report_evidencereporter, {{.}} {{/str}}</p>
    {{/shared}}

    {{^hasrows}}
    <div class="alert alert-info">{{#str}} adjustmentsnonelearners, report_evidencereporter {{/str}}</div>
    {{/hasrows}}
    {{#hasrows}}
    {{> report_evidencereporter/declarations_table }}
    {{/hasrows}}
</div>
