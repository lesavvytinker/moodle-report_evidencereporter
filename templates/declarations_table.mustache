{{!
    @template report_evidencereporter/declarations_table

    The RA and LLN form: a row per learner (or per assessment), with Yes and No tick boxes for each, details that open on
    Yes, and tick-all boxes. Used by the RA and LLN pages and the before-marking checklist.

    Example context (json):
    {
        "action": "https://example.com/report/evidencereporter/declarations.php?cmid=1", "sesskey": "abc",
        "canmanage": true, "rowlabel": "Learner", "backurl": null,
        "rows": [{"key": 3, "name": "Paige Palette", "canedit": true, "recorded": false, "partly": false, "recordedtext": "",
            "carried": "", "rayes": true, "rano": false, "radetails": "Extra time (20 minutes)", "raerror": "",
            "llnyes": false, "llnno": false, "llndetails": "", "llnerror": "", "adjustments": "Extra time (20 minutes)",
            "adjustmentsurl": "https://example.com/report/evidencereporter/adjustments.php?cmid=1", "held": false, "url": null,
            "rafromadjustment": false, "ralocked": false, "suggestion": "Extension to 3 Dec 2026"}]
    }
}}
    <form method="post" action="{{action}}" class="er-declform">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <div class="table-responsive">
        <table class="table table-sm table-bordered er-declarations">
            <colgroup>
                <col class="er-col-name">
                <col class="er-col-tick"><col class="er-col-tick"><col class="er-col-details">
                <col class="er-col-tick"><col class="er-col-tick"><col class="er-col-details">
            </colgroup>
            <thead>
                <tr>
                    <th scope="col" rowspan="2">{{rowlabel}}</th>
                    <th scope="colgroup" colspan="3" class="text-center er-declgroup">{{#str}} declra, report_evidencereporter {{/str}}</th>
                    <th scope="colgroup" colspan="3" class="text-center er-declgroup">{{#str}} decllln, report_evidencereporter {{/str}}</th>
                </tr>
                <tr>
                    <th scope="col" class="er-declcheck">
                        <label class="d-block mb-1" for="er-all-rayes">{{#str}} yes {{/str}}</label>
                        {{#canmanage}}<input type="checkbox" class="form-check-input" id="er-all-rayes" data-er-all="ra-yes"><label class="visually-hidden" for="er-all-rayes">{{#str}} declallrayes, report_evidencereporter {{/str}}</label>{{/canmanage}}
                    </th>
                    <th scope="col" class="er-declcheck">
                        <label class="d-block mb-1" for="er-all-rano">{{#str}} no {{/str}}</label>
                        {{#canmanage}}<input type="checkbox" class="form-check-input" id="er-all-rano" data-er-all="ra-no"><label class="visually-hidden" for="er-all-rano">{{#str}} declallrano, report_evidencereporter {{/str}}</label>{{/canmanage}}
                    </th>
                    <th scope="col">{{#str}} declradetails, report_evidencereporter {{/str}}</th>
                    <th scope="col" class="er-declcheck">
                        <label class="d-block mb-1" for="er-all-llnyes">{{#str}} yes {{/str}}</label>
                        {{#canmanage}}<input type="checkbox" class="form-check-input" id="er-all-llnyes" data-er-all="lln-yes"><label class="visually-hidden" for="er-all-llnyes">{{#str}} declallllnyes, report_evidencereporter {{/str}}</label>{{/canmanage}}
                    </th>
                    <th scope="col" class="er-declcheck">
                        <label class="d-block mb-1" for="er-all-llnno">{{#str}} no {{/str}}</label>
                        {{#canmanage}}<input type="checkbox" class="form-check-input" id="er-all-llnno" data-er-all="lln-no"><label class="visually-hidden" for="er-all-llnno">{{#str}} declallllnno, report_evidencereporter {{/str}}</label>{{/canmanage}}
                    </th>
                    <th scope="col">{{#str}} declllndetails, report_evidencereporter {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                <tr data-er-row="{{key}}" class="{{^recorded}}er-declpending{{/recorded}}">
                    <th scope="row">
                        <input type="hidden" name="key[]" value="{{key}}">
                        {{#url}}<a href="{{.}}">{{name}}</a>{{/url}}{{^url}}{{name}}{{/url}}
                        {{#held}}<span class="badge er-declnotrecorded ms-1">{{#str}} markingdeclheld, report_evidencereporter {{/str}}</span>{{/held}}
                        <div class="small">
                            {{#recorded}}<span class="text-muted">{{recordedtext}}</span>{{/recorded}}
                            {{#carried}}<div class="er-declcarried">{{#str}} declcarried, report_evidencereporter, {{.}} {{/str}}</div>{{/carried}}
                            {{^recorded}}{{#partly}}<span class="badge er-declpartly">{{#str}} declpartly, report_evidencereporter {{/str}}</span>{{/partly}}{{^partly}}<span class="badge er-declnotrecorded">{{#str}} declnotrecorded, report_evidencereporter {{/str}}</span>{{/partly}}{{/recorded}}
                        </div>
                    </th>
                    <td class="er-declcheck">
                        <input type="checkbox" class="form-check-input" name="ra_yes[{{key}}]" value="1" id="er-rayes-{{key}}" data-er-col="ra-yes" data-er-field="ra" data-er-answer="yes"{{#rayes}} checked{{/rayes}}{{#ralocked}} disabled{{/ralocked}}>
                        <label class="visually-hidden" for="er-rayes-{{key}}">{{#str}} declrayesfor, report_evidencereporter, {{name}} {{/str}}</label>
                    </td>
                    <td class="er-declcheck">
                        <input type="checkbox" class="form-check-input" name="ra_no[{{key}}]" value="1" id="er-rano-{{key}}" data-er-col="ra-no" data-er-field="ra" data-er-answer="no"{{#rano}} checked{{/rano}}{{#ralocked}} disabled{{/ralocked}}>
                        <label class="visually-hidden" for="er-rano-{{key}}">{{#str}} declranofor, report_evidencereporter, {{name}} {{/str}}</label>
                    </td>
                    <td>
                        {{#rafromadjustment}}
                        <div class="small er-declfromadjustment">{{#str}} decladjustmentsrecorded, report_evidencereporter {{/str}}: <a href="{{adjustmentsurl}}">{{adjustments}}</a></div>
                        {{/rafromadjustment}}
                        {{^rafromadjustment}}
                        <label class="visually-hidden" for="er-radetails-{{key}}">{{#str}} declradetailsfor, report_evidencereporter, {{name}} {{/str}}</label>
                        <textarea class="form-control form-control-sm{{#raerror}} is-invalid{{/raerror}}" id="er-radetails-{{key}}" name="radetails[{{key}}]" rows="2" data-er-details="ra"{{^canedit}} readonly{{/canedit}}>{{radetails}}</textarea>
                        {{#raerror}}<div class="invalid-feedback d-block">{{.}}</div>{{/raerror}}
                        {{#suggestion}}<div class="small text-muted mt-1">{{#str}} declsuggestion, report_evidencereporter, {{.}} {{/str}}</div>{{/suggestion}}
                        {{/rafromadjustment}}
                    </td>
                    <td class="er-declcheck">
                        <input type="checkbox" class="form-check-input" name="lln_yes[{{key}}]" value="1" id="er-llnyes-{{key}}" data-er-col="lln-yes" data-er-field="lln" data-er-answer="yes"{{#llnyes}} checked{{/llnyes}}{{^canedit}} disabled{{/canedit}}>
                        <label class="visually-hidden" for="er-llnyes-{{key}}">{{#str}} declllnyesfor, report_evidencereporter, {{name}} {{/str}}</label>
                    </td>
                    <td class="er-declcheck">
                        <input type="checkbox" class="form-check-input" name="lln_no[{{key}}]" value="1" id="er-llnno-{{key}}" data-er-col="lln-no" data-er-field="lln" data-er-answer="no"{{#llnno}} checked{{/llnno}}{{^canedit}} disabled{{/canedit}}>
                        <label class="visually-hidden" for="er-llnno-{{key}}">{{#str}} declllnnofor, report_evidencereporter, {{name}} {{/str}}</label>
                    </td>
                    <td>
                        <label class="visually-hidden" for="er-llndetails-{{key}}">{{#str}} declllndetailsfor, report_evidencereporter, {{name}} {{/str}}</label>
                        <textarea class="form-control form-control-sm{{#llnerror}} is-invalid{{/llnerror}}" id="er-llndetails-{{key}}" name="llndetails[{{key}}]" rows="2" data-er-details="lln"{{^canedit}} readonly{{/canedit}}>{{llndetails}}</textarea>
                        {{#llnerror}}<div class="invalid-feedback d-block">{{.}}</div>{{/llnerror}}
                    </td>
                </tr>
                {{/rows}}
            </tbody>
        </table>
        </div>
        {{#canmanage}}
        <button type="submit" class="btn btn-primary">{{#str}} declsave, report_evidencereporter {{/str}}</button>
        <span class="small text-muted ms-2">{{#str}} declsavenote, report_evidencereporter {{/str}}</span>
        {{/canmanage}}
        {{#backurl}}<a class="btn btn-link" href="{{.}}">{{#str}} declbacktomarking, report_evidencereporter {{/str}}</a>{{/backurl}}
    </form>
{{#js}}
(function() {
    document.querySelectorAll('form.er-declform:not([data-er-ready])').forEach(function(root) {
        root.dataset.erReady = '1';
        var cols = ['ra-yes', 'ra-no', 'lln-yes', 'lln-no'];
        var boxes = function(col) {
            return Array.prototype.slice.call(root.querySelectorAll('input[data-er-col="' + col + '"]:not([disabled])'));
        };
        // Yes and No exclude each other; the details box opens on Yes.
        var sync = function(box) {
            var row = box.closest('tr');
            var field = box.dataset.erField;
            if (box.checked) {
                var other = box.dataset.erAnswer === 'yes' ? 'no' : 'yes';
                var sibling = row.querySelector('input[data-er-col="' + field + '-' + other + '"]');
                if (sibling) {
                    sibling.checked = false;
                }
            }
            var yes = row.querySelector('input[data-er-col="' + field + '-yes"]');
            var details = row.querySelector('textarea[data-er-details="' + field + '"]');
            if (details && yes) {
                details.disabled = !yes.checked;
            }
        };
        var syncAll = function() {
            cols.forEach(function(col) {
                var all = root.querySelector('input[data-er-all="' + col + '"]');
                if (!all) {
                    return;
                }
                var list = boxes(col);
                var ticked = list.filter(function(b) {
                    return b.checked;
                }).length;
                all.checked = list.length > 0 && ticked === list.length;
                all.indeterminate = ticked > 0 && ticked < list.length;
            });
        };
        // Details open only on Yes (left open without JavaScript).
        boxes('ra-yes').concat(boxes('lln-yes')).forEach(sync);
        cols.forEach(function(col) {
            boxes(col).forEach(function(box) {
                box.addEventListener('change', function() {
                    sync(box);
                    syncAll();
                });
            });
            var all = root.querySelector('input[data-er-all="' + col + '"]');
            if (all) {
                all.addEventListener('change', function() {
                    boxes(col).forEach(function(box) {
                        box.checked = all.checked;
                        sync(box);
                    });
                    syncAll();
                });
            }
        });
        syncAll();
    });
})();
{{/js}}
